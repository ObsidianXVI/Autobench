# Copy to .env and fill in. Never commit .env.

# --- Alpaca market data (https://app.alpaca.markets -> API Keys) ---
# Paper-account keys work for market data.
# ALPACA_API_KEY is accepted as an alias for ALPACA_API_KEY_ID. Both values are required.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# "sip" (consolidated, all exchanges; free plan allows historical data older than 15 min)
# or "iex" (IEX exchange only; volume is a small fraction of total market volume).
# With "sip", requests that the plan does not permit automatically fall back to "iex".
ALPACA_DATA_FEED=sip
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Bar/quote provider: auto (alpaca when keys are set, else yahoo) | alpaca | yahoo
AUTOBENCH_BAR_PROVIDER=auto

# SEC EDGAR asks for a descriptive User-Agent with contact info: "AppName your@email.com"
SEC_USER_AGENT=

# Server
AUTOBENCH_HOST=127.0.0.1
AUTOBENCH_PORT=8000
AUTOBENCH_DB_PATH=
AUTOBENCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Trading ---
# Broker: ibkr (IB Gateway / TWS) | sim (built-in simulator) | none. Changeable on the Trading page.
AUTOBENCH_BROKER=ibkr
# IB Gateway paper 4002 (live 4001); TWS paper 7497 (live 7496). Client id must be unique per API app.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=7
# Default account when the login holds several (switchable in the app; empty = the first one)
IBKR_ACCOUNT=
# Live (non-paper) accounts stay read-only unless this is 1 AND live trading is armed in the UI.
AUTOBENCH_ALLOW_LIVE_TRADING=0

# Vral Altos cloud copy of the portfolio (agents read it while this Mac is off).
# Needs `gcloud auth application-default login`. Empty = off.
AUTOBENCH_CLOUD_SYNC_PROJECT=
# AUTOBENCH_CLOUD_SYNC_INTERVAL=300

# Financier mode (Mode selector → Financier). Its Flutter web build, served at /financier/
# (default: ../Financier/app/build/web), and the Firebase project both modes share for the
# links between them (default: AUTOBENCH_CLOUD_SYNC_PROJECT, else vral-altos). Read-only,
# with the same `gcloud auth application-default login`.
# AUTOBENCH_FINANCIER_DIR=
# AUTOBENCH_FIREBASE_PROJECT=vral-altos

# --- Cloud (Cloud Run sets these; see deploy/ and Vral_Altos/infra/autobench.tf) ---
# Firestore state store: set to use Firestore as the source of truth (dev: with FIRESTORE_EMULATOR_HOST).
# AUTOBENCH_STATE_PROJECT=
# AUTOBENCH_STATE_DATABASE=platform
# AUTOBENCH_STATE_BUCKET=
# IB Gateway inside the container, on demand: managed | (empty: you run IB Gateway/TWS)
# AUTOBENCH_GATEWAY=
# AUTOBENCH_GATEWAY_MODE=paper
# AUTOBENCH_GATEWAY_IDLE_MINUTES=30
# Identity-Aware Proxy (cloud only)
# AUTOBENCH_IAP_AUDIENCE=
# AUTOBENCH_OWNER_EMAILS=
